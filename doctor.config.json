{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": [
      "src/data/*.generated.ts",
      "src/app/admin/**",
      "src/app/api/admin/**",
      "src/components/admin/**",
      "src/lib/admin*.ts",
      "dist-admin/**"
    ],
    "overrides": [
      {
        "files": ["src/app/RootDocument.tsx"],
        "rules": [
          "react-doctor/nextjs-no-native-script",
          "react-doctor/no-undeferred-third-party",
          "react-doctor/rendering-script-defer-async"
        ]
      },
      {
        "files": [
          "src/admin/PhotoUploadButton.tsx",
          "src/admin/photoEncoding.ts"
        ],
        "rules": ["react-doctor/async-await-in-loop"]
      }
    ]
  },
  "rules": {
    "react-doctor/nextjs-no-img-element": "off"
  }
}
