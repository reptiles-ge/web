{
  "name": "reptiles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "js-yaml@^3.13.1": "3.15.2",
      "js-yaml@^4.1.0": "4.3.2",
      "nanoid@^3.3.8": "3.3.18"
    }
  },
  "scripts": {
    "compile": "pnpm run species:compile && pnpm run search:compile && pnpm run map:compile",
    "predev": "pnpm run compile",
    "browse": "tsx scripts/browse-reptiles.ts",
    "dev": "next dev --port 3333",
    "prebuild": "pnpm run compile",
    "pretest": "pnpm run compile",
    "build": "next build",
    "analyze": "pnpm run prebuild && ANALYZE=true pnpm exec next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "doctor": "react-doctor -y --verbose",
    "doctor:changed": "react-doctor -y --verbose --scope changed",
    "doctor:check": "node scripts/check-doctor-score.mjs",
    "doctor:full": "react-doctor -y --verbose --scope full",
    "seo:audit": "pnpm run seo:graph && tsx scripts/reptiles-seo.ts audit",
    "seo:audit:ga4": "pnpm run seo:graph && tsx scripts/reptiles-seo.ts ga4",
    "seo:audit:gsc": "pnpm run seo:graph && tsx scripts/reptiles-seo.ts gsc",
    "seo:audit:geo": "pnpm run seo:graph && tsx scripts/reptiles-seo.ts geo",
    "seo:audit:technical": "pnpm run seo:graph && tsx scripts/reptiles-seo.ts technical",
    "seo:graph": "pnpm run species:compile && tsx scripts/export-seo-graph.ts",
    "seo:selfcheck": "tsx scripts/reptiles-seo.ts selfcheck",
    "seo:serp": "tsx scripts/reptiles-seo.ts serp",
    "knip": "knip",
    "cpd": "jscpd",
    "i18n:check": "i18n-check --locales messages --source ka --format next-intl --ignore regions.regionTitle regions.speciesTitle regions.venomousTitle regions.faqIntro regions.regionMetaTitle regions.regionMetaDescription amphibianFrogs.guideP2",
    "i18n:usage": "node scripts/check-i18n-usage.mjs",
    "test": "vitest run && node --import tsx --test tests/proxy-cacheability.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "species:compile": "tsx scripts/compile-species.ts && tsx scripts/compile-occurrences.ts && tsx scripts/compile-locale-switch-index.ts",
    "locale-switch:compile": "tsx scripts/compile-locale-switch-index.ts",
    "search:compile": "tsx scripts/compile-search.ts",
    "map:compile": "tsx scripts/compile-georgia-map.ts",
    "images:check": "tsx scripts/check-image-urls.ts",
    "images:check-og": "tsx scripts/compile-species.ts && tsx scripts/check-og-images.ts",
    "images:og-missing": "tsx scripts/compile-species.ts && tsx scripts/generate-missing-og.ts",
    "images:og-guides": "tsx scripts/generate-guide-og.ts",
    "images:unused": "node scripts/remove-unused-images.js",
    "images:unused:delete": "node scripts/remove-unused-images.js --delete",
    "images:cdn-unused": "tsx scripts/cdn-unused-images.ts",
    "images:optimize": "tsx scripts/compile-species.ts && tsx scripts/optimize-images.ts",
    "images:optimize:dry": "tsx scripts/compile-species.ts && tsx scripts/optimize-images.ts --dry-run",
    "images:optimize:news": "tsx scripts/compile-species.ts && tsx scripts/optimize-images.ts --news",
    "images:optimize:site": "tsx scripts/compile-species.ts && tsx scripts/optimize-images.ts --site",
    "images:emit": "tsx scripts/compile-species.ts && tsx scripts/optimize-images.ts --emit-only",
    "inaturalist:field-records": "tsx scripts/import-inaturalist-field-records.ts",
    "format": "prettier --write .",
    "prepare": "husky",
    "dev:vinext": "VINEXT=1 vinext dev --port 3001",
    "prebuild:vinext": "pnpm run prebuild",
    "build:vinext": "VINEXT=1 vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "pnpm run build:vinext && vinext-cloudflare deploy --config dist/server/wrangler.json && pnpm run cache:warm",
    "cache:warm": "node scripts/warm-cache.mjs",
    "deploy:response-store": "wrangler deploy --config wrangler.response-store.jsonc"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@bprogress/next": "^3.2.12",
    "@bprogress/react": "^1.2.7",
    "@cloudflare/workers-response-store": "1.0.1",
    "@sentry/nextjs": "^10.74.0",
    "@vinext/cloudflare": "1.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-intl": "^4.14.8",
    "nuqs": "2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "vinext": "1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.3",
    "@lingual/i18n-check": "^0.9.5",
    "@next/bundle-analyzer": "16.3.8",
    "@playwright/test": "1.63.0",
    "@reptiles-ge/img-compression": "github:reptiles-ge/img-compression#feat/og-images",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-next-edge-boundary": "0.1.1",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jscpd": "^5.4.0",
    "knip": "6.39.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-doctor": "^0.9.14",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.2",
    "vitest": "4.1.11",
    "wrangler": "^4.145.0",
    "zod": "3.25.76"
  }
}
