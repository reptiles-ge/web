{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reptiles-api",
  "main": "src/api/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.reptiles.ge",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reptiles-db",
      "database_id": "70504a48-9615-4ec5-9e47-d02affda6e5a",
      "migrations_dir": "migrations/api",
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
