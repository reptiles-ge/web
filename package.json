    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-intl": "^4.13.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@reptiles-ge/img-compression": "github:reptiles-ge/img-compression#chore/installable-from-git",
    "@tailwindcss/postcss": "^4",
