{
  "name": "reptiles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "js-yaml@^3.13.1": "3.15.2",
      "js-yaml@^4.1.0": "4.3.2",
      "nanoid@^3.3.8": "3.3.18"
    }
  },
  "scripts": {
    "predev": "tsx scripts/compile-species.ts && tsx scripts/compile-locale-switch-index.ts && tsx scripts/compile-search.ts && tsx scripts/compile-georgia-map.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/compile-species.ts && tsx scripts/compile-locale-switch-index.ts && tsx scripts/compile-search.ts && tsx scripts/compile-georgia-map.ts",
    "pretest": "tsx scripts/compile-species.ts && tsx scripts/compile-locale-switch-index.ts && tsx scripts/compile-search.ts && tsx scripts/compile-georgia-map.ts",
    "build": "next build",
    "analyze": "pnpm run prebuild && ANALYZE=true pnpm exec next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "doctor": "react-doctor -y --verbose",
    "doctor:changed": "react-doctor -y --verbose --scope changed",
    "doctor:content": "pnpm run species:compile && pnpm run atlas:graph && PATH=\"$HOME/.cargo/bin:$PATH\" cargo run --manifest-path tools/atlas-doctor/Cargo.toml --quiet -- .atlas/graph.json",
    "doctor:full": "react-doctor -y --verbose --scope full",
    "doctor:seo": "pnpm run seo:graph && tsx scripts/run-seo-doctor.ts",
    "doctor:seo:ci": "pnpm run build && pnpm run doctor:seo",
    "atlas:graph": "tsx scripts/export-atlas-graph.ts",
    "seo:audit": "pnpm run seo:graph && tsx scripts/reptiles-seo.ts audit",
    "seo:audit:ga4": "pnpm run seo:graph && tsx scripts/reptiles-seo.ts ga4",
    "seo:audit:gsc": "pnpm run seo:graph && tsx scripts/reptiles-seo.ts gsc",
    "seo:audit:geo": "pnpm run seo:graph && tsx scripts/reptiles-seo.ts geo",
    "seo:audit:technical": "pnpm run seo:graph && tsx scripts/reptiles-seo.ts technical",
    "seo:audit:url": "pnpm run seo:graph && tsx scripts/reptiles-seo.ts audit",
    "seo:doctor": "PATH=\"$HOME/.cargo/bin:$PATH\" cargo run --manifest-path tools/seo-doctor/Cargo.toml --quiet -- .seo/graph.json",
    "seo:graph": "pnpm run species:compile && tsx scripts/export-seo-graph.ts",
    "seo:report": "pnpm run seo:audit",
    "seo:selfcheck": "tsx scripts/reptiles-seo.ts selfcheck",
    "seo:serp": "tsx scripts/reptiles-seo.ts serp",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "species:compile": "tsx scripts/compile-species.ts && tsx scripts/compile-locale-switch-index.ts",
    "locale-switch:compile": "tsx scripts/compile-locale-switch-index.ts",
    "search:compile": "tsx scripts/compile-search.ts",
    "map:compile": "tsx scripts/compile-georgia-map.ts",
    "images:check": "tsx scripts/check-image-urls.ts",
    "images:check-og": "tsx scripts/compile-species.ts && tsx scripts/check-og-images.ts",
    "images:og-missing": "tsx scripts/compile-species.ts && tsx scripts/generate-missing-og.ts",
    "images:unused": "node scripts/remove-unused-images.js",
    "images:unused:delete": "node scripts/remove-unused-images.js --delete",
    "images:cdn-unused": "tsx scripts/cdn-unused-images.ts",
    "images:optimize": "tsx scripts/compile-species.ts && tsx scripts/optimize-images.ts",
    "images:optimize:dry": "tsx scripts/compile-species.ts && tsx scripts/optimize-images.ts --dry-run",
    "images:optimize:news": "tsx scripts/compile-species.ts && tsx scripts/optimize-images.ts --news",
    "images:optimize:site": "tsx scripts/compile-species.ts && tsx scripts/optimize-images.ts --site",
    "images:emit": "tsx scripts/compile-species.ts && tsx scripts/optimize-images.ts --emit-only",
    "inaturalist:field-records": "tsx scripts/import-inaturalist-field-records.ts",
    "format": "prettier --write .",
    "prepare": "husky",
    "dev:vinext": "VINEXT=1 vinext dev --port 3001",
    "build:vinext": "VINEXT=1 vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "pnpm run build:vinext && vinext-cloudflare deploy --config dist/server/wrangler.json --experimental-warm-cdn-cache",
    "deploy:response-store": "wrangler deploy --config wrangler.response-store.jsonc"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@cloudflare/workers-response-store": "0.1.0-beta.0",
    "@sentry/nextjs": "^10.74.0",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.28.0",
    "next": "16.3.3",
    "next-intl": "^4.13.4",
    "nprogress": "^0.2.0",
    "nuqs": "2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "vinext": "1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.9",
    "@next/bundle-analyzer": "16.3.3",
    "@playwright/test": "1.55.1",
    "@reptiles-ge/img-compression": "github:reptiles-ge/img-compression#feat/og-images",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-next-edge-boundary": "0.1.1",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "knip": "6.32.3",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-doctor": "^0.9.13",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "4.1.11",
    "wrangler": "^4.131.2",
    "zod": "3.25.76"
  }
}
