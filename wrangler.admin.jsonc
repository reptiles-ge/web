{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reptiles-admin",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "admin.reptiles.ge",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist-admin",
    "not_found_handling": "single-page-application",
  },
}
