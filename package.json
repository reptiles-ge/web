{
  "name": "reptiles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@^3.13.1": "3.15.2",
      "js-yaml@^4.1.0": "4.3.2",
      "nanoid@^3.3.8": "3.3.18"
    },
    "patchedDependencies": {
      "vinext@1.0.1": "patches/vinext@1.0.1.patch"
    }
  },
  "scripts": {
    "compile": "pnpm run news:compile && pnpm run content:compile && pnpm run slugs:compile && pnpm run images:compile",
    "predev": "pnpm run compile",
    "browse": "tsx scripts/browse-reptiles.ts",
    "dev": "next dev --port 3333",
    "dev:inspect": "pnpm run compile && node --experimental-network-inspection node_modules/next/dist/bin/next dev --port 3333 --inspect",
    "prebuild": "pnpm run compile",
    "pretest": "pnpm run compile",
    "build": "next build",
    "analyze": "pnpm run prebuild && ANALYZE=true pnpm exec next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "doctor": "react-doctor -y --verbose",
    "doctor:changed": "react-doctor -y --verbose --scope changed",
    "doctor:check": "node scripts/check-doctor-score.mjs",
    "doctor:full": "react-doctor -y --verbose --scope full",
    "seo:audit": "pnpm run seo:graph && tsx scripts/reptiles-seo.ts audit",
    "seo:audit:ga4": "pnpm run seo:graph && tsx scripts/reptiles-seo.ts ga4",
    "seo:audit:gsc": "pnpm run seo:graph && tsx scripts/reptiles-seo.ts gsc",
    "seo:audit:geo": "pnpm run seo:graph && tsx scripts/reptiles-seo.ts geo",
    "seo:audit:technical": "pnpm run seo:graph && tsx scripts/reptiles-seo.ts technical",
    "seo:graph": "pnpm run news:compile && pnpm run content:compile && pnpm run slugs:compile && tsx scripts/export-seo-graph.ts",
    "seo:selfcheck": "tsx scripts/reptiles-seo.ts selfcheck",
    "seo:serp": "tsx scripts/reptiles-seo.ts serp",
    "knip": "knip",
    "cpd": "jscpd",
    "i18n:check": "i18n-check --locales messages --source ka --format next-intl --ignore regions.regionTitle regions.speciesTitle regions.venomousTitle regions.faqIntro regions.regionMetaTitle regions.regionMetaTitleShort regions.regionMetaDescription amphibianFrogs.guideP2",
    "i18n:usage": "node scripts/check-i18n-usage.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "news:compile": "tsx scripts/compile-news.ts",
    "news:import": "tsx scripts/news-import.ts",
    "species:draft": "tsx scripts/species-draft.ts",
    "slugs:compile": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/compile-species-slugs.ts",
    "images:compile": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/compile-optimized-images.ts",
    "content:compile": "tsx scripts/compile-content-dates.ts && tsx scripts/compile-release-version.ts",
    "taxon:ids": "tsx scripts/fetch-taxon-identifiers.ts",
    "photos:licenses": "tsx scripts/fetch-photo-licenses.ts",
    "map:compile": "tsx scripts/compile-georgia-map.ts",
    "images:check": "pnpm run slugs:compile && tsx scripts/check-image-urls.ts",
    "images:check-og": "pnpm run slugs:compile && tsx scripts/check-og-images.ts",
    "images:og-missing": "pnpm run slugs:compile && pnpm run images:compile && tsx scripts/generate-missing-og.ts",
    "images:og-guides": "tsx scripts/generate-guide-og.ts",
    "images:news-schema": "pnpm run news:compile && pnpm run content:compile && pnpm run slugs:compile && tsx scripts/generate-news-schema-images.ts",
    "images:unused": "node scripts/remove-unused-images.js",
    "images:unused:delete": "node scripts/remove-unused-images.js --delete",
    "images:cdn-unused": "tsx scripts/cdn-unused-images.ts",
    "images:optimize": "pnpm run slugs:compile && tsx scripts/optimize-images.ts",
    "images:optimize:dry": "pnpm run slugs:compile && tsx scripts/optimize-images.ts --dry-run",
    "images:optimize:news": "pnpm run slugs:compile && tsx scripts/optimize-images.ts --news",
    "images:optimize:site": "pnpm run slugs:compile && tsx scripts/optimize-images.ts --site",
    "images:emit": "pnpm run slugs:compile && tsx scripts/optimize-images.ts --emit-only",
    "images:warm": "pnpm run images:og-missing && pnpm run images:news-schema --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "dev:vinext": "VINEXT=1 vinext dev --port 3001",
    "prebuild:vinext": "pnpm run prebuild",
    "build:vinext": "NODE_ENV=production VINEXT=1 vinext build",
    "postbuild:vinext": "pnpm run build:check-dev-only",
    "build:check-dev-only": "node scripts/check-dev-only-build.mjs",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json --config wrangler.response-store.jsonc",
    "deploy:vinext": "pnpm run build:vinext && vinext-cloudflare deploy --config dist/server/wrangler.json && pnpm run cache:warm",
    "cache:warm": "node scripts/warm-cache.mjs",
    "metadata:check": "tsx scripts/check-metadata-head.ts",
    "deploy:response-store": "wrangler deploy --config wrangler.response-store.jsonc",
    "dev:api": "wrangler dev --config wrangler.api.jsonc --port 8787",
    "deploy:api": "wrangler deploy --config wrangler.api.jsonc",
    "dev:admin": "vite --config vite.admin.config.ts",
    "prebuild:admin": "pnpm run images:compile",
    "build:admin": "vite build --config vite.admin.config.ts",
    "preview:admin": "pnpm run build:admin && wrangler dev --config wrangler.admin.jsonc --port 3003",
    "deploy:admin": "pnpm run build:admin && wrangler deploy --config wrangler.admin.jsonc",
    "db:migrations:list": "wrangler d1 migrations list reptiles-db --local --config wrangler.api.jsonc",
    "db:migrate": "wrangler d1 migrations apply reptiles-db --local --config wrangler.api.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply reptiles-db --remote --config wrangler.api.jsonc",
    "db:seed:local": "wrangler d1 execute reptiles-db --local --config wrangler.api.jsonc --file tests/fixtures/speciesSeed.sql",
    "db:import:news": "pnpm run news:compile && tsx scripts/export-news-sql.ts && wrangler d1 execute reptiles-db --local --config wrangler.api.jsonc --file .wrangler/news-import.sql",
    "db:import:news:remote": "pnpm run news:compile && tsx scripts/export-news-sql.ts && wrangler d1 execute reptiles-db --remote --config wrangler.api.jsonc --file .wrangler/news-import.sql"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@bprogress/next": "^3.2.12",
    "@bprogress/react": "^1.2.7",
    "@cloudflare/workers-response-store": "1.1.0",
    "@hono/zod-validator": "0.9.1",
    "@scalar/hono-api-reference": "0.12.12",
    "@sentry/nextjs": "^11.6.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@vinext/cloudflare": "1.0.1",
    "antd": "^6.6.6",
    "clsx": "^2.1.1",
    "framer-motion": "^14.1.0",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "hono": "4.13.13",
    "leaflet": "^1.9.4",
    "lodash": "^4.18.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "nuqs": "2.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "vinext": "1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@lingual/i18n-check": "^0.9.5",
    "@next/bundle-analyzer": "16.4.2",
    "@playwright/test": "1.64.0",
    "@reptiles-ge/img-compression": "github:reptiles-ge/img-compression#97da0fd516ae26c42c398598376cd5c3e44c3a28",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/lodash": "^4.17.26",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-next-edge-boundary": "0.1.1",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "jscpd": "^5.4.1",
    "knip": "6.41.0",
    "lint-staged": "^17.6.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-doctor": "^0.9.17",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vite": "^8.3.4",
    "vitest": "5.0.3",
    "wrangler": "^4.151.1",
    "zod": "4.6.6"
  }
}
