{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reptiles",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/index.js",
  "build": {
    "command": "pnpm build:vinext",
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"],
    },
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "cache": {
    "enabled": false,
  },
  "services": [
    {
      "binding": "RESPONSE_STORE",
      "service": "reptiles-response-store",
      "entrypoint": "ResponseStoreService",
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "r2_buckets": [
    {
      "bucket_name": "reptiles-response-store-cache-bodies",
      "binding": "reptiles_response_store_cache_bodies",
      "remote": true,
    },
  ],
}
