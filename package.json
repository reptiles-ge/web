  "private": true,
  "scripts": {
    "predev": "tsx scripts/compile-species.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/compile-species.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test src/lib/snakeQuiz.test.ts",
    "species:compile": "tsx scripts/compile-species.ts",
